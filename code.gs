/**
 * ================================================================
 * SLI AUTOMATION
 * VERSION 1.3
 * ================================================================
 *
 * INPUT:
 * JSON generated by the Gemini Gem:
 * "SLI Data Preparation & Validation"
 *
 * OUTPUT:
 * 1. Completed native Google Doc
 * 2. Microsoft Word .docx
 * 3. PDF .pdf
 *
 * ================================================================
 * STATIC MASTER FIELDS - NEVER MODIFY
 * ================================================================
 *
 * The following fields are configured directly in:
 * "AIT SLI - AUTOMATION MASTER"
 *
 * The script MUST NEVER modify them:
 *
 * - Box 8  - Related Party Indicator
 * - Box 9  - Routed Export Transaction
 * - Box 10 - Hazardous Material
 * - Box 12 - Ultimate Consignee Type
 * - Box 15 - Carnet
 * - Box 16 - TIB
 * - Mode of Transport
 * - Incoterms 2020
 * - Box 30 - DDTC Applicant Registration Number
 * - Box 31 - Eligible Party Certification
 * - Box 32 - Low-value AES indicator
 * - Box 35 - Exporter E-mail Address
 * - Box 36 - Exporter Telephone Number
 * - Box 37 - Printed Name
 * - Box 38 - Signature
 * - Box 39 - Title
 *
 * Box 40 - Date IS DYNAMIC.
 *
 * ================================================================
 * IMPORTANT
 * ================================================================
 *
 * Before running:
 *
 * 1. Set TEMPLATE_DOC_ID
 * 2. Set OUTPUT_FOLDER_ID
 *
 */


const CONFIG = Object.freeze({

  SHEET_NAME: 'SLI Control',

  // Native Google Docs master template ID
  TEMPLATE_DOC_ID: 'YOUR_GOOGLE_DOC_TEMPLATE_ID',

  // Google Drive destination folder ID
  OUTPUT_FOLDER_ID: 'YOUR_OUTPUT_FOLDER_ID',

  MAX_COMMODITIES: 5,

  SCHEMA_VERSION: '1.3'

});


const MIME = Object.freeze({

  DOCX:
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',

  PDF:
    'application/pdf'

});


/**
 * Cargo Insurance remains automated.
 *
 * Insurance Requested is always YES.
 */
const CHECKED = '☒';
const UNCHECKED = '☐';


