/**
 * ================================================================
 * MENU
 * ================================================================
 */

function onOpen() {

  SpreadsheetApp
    .getUi()
    .createMenu('SLI Automation')
    .addItem(
      '1. Setup Control Sheet',
      'setupControlSheet'
    )
    .addItem(
      '2. Validate Master Template',
